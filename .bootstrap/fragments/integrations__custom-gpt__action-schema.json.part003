"
          },
          "project": {
            "$ref": "#/components/schemas/Project"
          },
          "compilerVersion": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "openZeppelinVersion": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
          },
          "chain": {
            "type": "string",
            "enum": [
              "ethereum",
              "base",
              "katana",
              "fraxtal",
              "arbitrum",
              "polygon",
              "optimism"
            ]
          },
          "block": {
            "oneOf": [
              {
                "const": "latest"
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "default": "latest"
          },
          "timeoutMinutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 35,
            "default": 10
          },
          "workflow": {
            "$ref": "#/components/schemas/Workflow"
          },
          "optimizer": {
            "$ref": "#/components/schemas/Optimizer"
          },
          "evmVersion": {
            "type": "string"
          },
          "viaIR": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "JobStatus": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "jobId",
          "status"
        ],
        "properties": {
          "jobId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ]
          },
          "stage": {
            "type": "string"
          },
          "chain": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "JobSummary": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "jobId",
          "status"
        ],
        "properties": {
          "jobId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "deployments": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "compiler": {
            "type": "object"
          },
          "workflow": {
            "type": "object"
          },
          "error": {
            "type": "object"
          }
        }
      },
      "JobResult": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "jobId",
          "status",
          "compilerDiagnostics",
          "steps",
          "startedAt",
          "finishedAt"
        ],
        "properties": {
          "jobId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "compilerDiagnostics": {
            "type": "array",
            "items": {}
          },
          "deployments": {
            "type": "object"
          },
          "steps": {
            "type": "array",
            "items": {}
          },
          "artifacts": {
            "type": "array",
            "items": {}
          },
          "error": {
            "type": "object"
          },
          "startedAt": {
            "type": "string"
          },
          "finishedAt": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            }
          }
        }
      }
    }
  }
}
