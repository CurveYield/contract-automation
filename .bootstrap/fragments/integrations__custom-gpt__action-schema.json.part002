 }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "parameters": {
      "JobId": {
        "name": "jobId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^job_[A-Za-z0-9]+$"
        }
      }
    },
    "schemas": {
      "InlineProject": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "files"
        ],
        "properties": {
          "type": {
            "const": "inline"
          },
          "files": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string"
            },
            "description": "Map of safe relative .sol paths to Solidity source text."
          }
        }
      },
      "GithubProject": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "repository"
        ],
        "properties": {
          "type": {
            "const": "github"
          },
          "repository": {
            "type": "string",
            "description": "Public owner/repository only."
          },
          "ref": {
            "type": "string",
            "default": "main"
          }
        }
      },
      "Project": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/InlineProject"
          },
          {
            "$ref": "#/components/schemas/GithubProject"
          }
        ]
      },
      "Optimizer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled",
          "runs"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "runs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          }
        }
      },
      "WorkflowStep": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "deploy",
              "call",
              "staticCall",
              "expectRevert",
              "setBalance",
              "transferNative",
              "mine",
              "increaseTime",
              "snapshot",
              "revertSnapshot",
              "assertBalance",
              "assertCall"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 200
          },
          "continueOnFailure": {
            "type": "boolean"
          },
          "alias": {
            "type": "string"
          },
          "contract": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {}
          },
          "from": {
            "type": "string"
          },
          "value": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "target": {
            "type": "string"
          },
          "function": {
            "type": "string"
          },
          "saveAs": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "amount": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
          "to": {
            "type": "string"
          },
          "blocks": {
            "type": "integer",
            "minimum": 1
          },
          "seconds": {
            "type": "integer",
            "minimum": 0
          },
          "snapshot": {
            "type": "string"
          },
          "equals": {},
          "min": {},
          "max": {}
        }
      },
      "Workflow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "steps"
        ],
        "properties": {
          "steps": {
            "type": "array",
            "maxItems": 200,
            "items": {
              "$ref": "#/components/schemas/WorkflowStep"
            }
          }
        }
      },
      "JobRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "compilerVersion"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "compile",
              "simulate"
            ],
            "default": "simulate