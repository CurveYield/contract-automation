{
  "schemaVersion": "round5-production-test-manifest-v1",
  "releaseBindingId": "round5-release-source-3da6b10-v1",
  "repository": "CurveYield/contract-automation",
  "state": "static-plan-only",
  "productionTestingAuthorized": false,
  "stageOrderingStrict": true,
  "stages": [
    {
      "id": "configuration-preflight",
      "prerequisites": ["accepted-release-source-binding", "closed-production-authorization-gates"],
      "checks": ["required-secret-and-variable-names-present-without-reading-values", "cloudflare-github-r2-domain-and-rpc-resource-bindings-match", "workflow-permissions-action-pins-and-event-trust-match"],
      "requiredEvidence": ["credential-name-readiness-report", "resource-binding-report", "workflow-static-trust-report"],
      "rejectConditions": ["missing-or-mismatched-name", "secret-bearing-pull-request-workflow", "mutable-action-reference", "broad-token-permission"]
    },
    {
      "id": "deployment",
      "prerequisites": ["configuration-preflight-accepted", "promotion-authorized", "deployment-authorized"],
      "checks": ["trusted-exact-sha-deployed", "worker-pages-r2-and-domain-bindings-verified", "deployment-rerun-idempotent"],
      "requiredEvidence": ["deployment-run-id", "deployed-exact-sha", "artifact-id-and-digest", "resource-and-domain-checkpoint", "configuration-digest"],
      "rejectConditions": ["untrusted-source-event", "source-sha-mismatch", "resource-binding-mismatch", "deployment-not-idempotent"]
    },
    {
      "id": "live-api-auth-gpt",
      "requiresVerifiedDeploymentCheckpoint": true,
      "prerequisites": ["verified-deployment-checkpoint", "live-production-testing-authorized", "bounded-test-identities-ready"],
      "checks": ["client-runner-and-github-bridge-authentication", "tenant-isolation", "gpt-request-and-response-contract", "recursive-redaction"],
      "requiredEvidence": ["bounded-request-matrix", "correlation-identifiers", "classified-results", "redaction-receipt"],
      "rejectConditions": ["authorization-bypass", "cross-tenant-access", "credential-disclosure", "unbounded-model-or-network-action"]
    },
    {
      "id": "live-r2",
      "requiresVerifiedDeploymentCheckpoint": true,
      "prerequisites": ["verified-deployment-checkpoint", "live-production-testing-authorized", "disposable-test-object-prefix-ready"],
      "checks": ["upload-grant-scope", "object-publication-and-readback", "cors-origin-enforcement", "lifecycle-and-partial-publication-recovery"],
      "requiredEvidence": ["test-object-identifiers", "r2-publication-receipt", "cors-result", "cleanup-and-recovery-receipt"],
      "rejectConditions": ["bucket-scope-escape", "unapproved-origin", "orphaned-partial-publication", "destructive-production-data-operation"]
    },
    {
      "id": "live-github-direct",
      "requiresVerifiedDeploymentCheckpoint": true,
      "prerequisites": ["verified-deployment-checkpoint", "live-production-testing-authorized", "bounded-test-issue-ready"],
      "checks": ["allowlisted-user-enforcement", "issue-label-and-comment-publication", "workflow-dispatch-policy", "duplicate-publication-reconciliation"],
      "requiredEvidence": ["test-issue-number", "comment-and-label-identifiers", "workflow-policy-result", "duplicate-reconciliation-receipt"],
      "rejectConditions": ["unauthorized-user-action", "repository-scope-escape", "duplicate-authoritative-publication", "secret-or-token-disclosure"]
    },
    {
      "id": "live-read-only-rpc",
      "requiresVerifiedDeploymentCheckpoint": true,
      "prerequisites": ["verified-deployment-checkpoint", "live-production-testing-authorized", "seven-network-rpc-name-readiness-confirmed"],
      "checks": ["chain-identity-and-pinned-block-read", "fail-closed-method-policy", "provider-error-redaction", "zero-signing-and-zero-public-broadcast"],
      "requiredEvidence": ["per-network-chain-identity", "allowed-and-denied-method-matrix", "redacted-error-result", "zero-broadcast-attestation"],
      "rejectConditions": ["transaction-method-forwarded", "account-or-signing-method-available", "raw-provider-location-disclosed", "public-chain-broadcast-observed"]
    },
    {
      "id": "web-operator",
      "requiresVerifiedDeploymentCheckpoint": true,
      "prerequisites": ["verified-deployment-checkpoint", "live-production-testing-authorized", "production-api-binding-confirmed"],
      "checks": ["pages-load-and-api-connectivity", "authentication-and-expiry-ux", "report-and-github-direct-rendering", "error-redaction-and-accessibility"],
      "requiredEvidence": ["viewport-and-route-matrix", "operator-flow-receipt", "accessibility-result", "redacted-error-samples"],
      "rejectConditions": ["stale-or-wrong-api-binding", "secret-rendered", "unsafe-admin-action", "critical-accessibility-or-operator-flow-failure"]
    },
    {
      "id": "observability-recovery",
      "requiresVerifiedDeploymentCheckpoint": true,
      "prerequisites": ["all-prior-live-stages-complete", "same-deployed-sha-and-configuration-digest", "recovery-drills-authorized"],
      "checks": ["correlation-and-classified-logging", "bounded-retention", "rollback-to-last-known-good", "idempotent-redeploy", "partial-and-duplicate-publication-recovery", "non-production-key-rotation"],
      "requiredEvidence": ["observability-query-receipt", "retention-verification", "rollback-and-redeploy-receipt", "recovery-drill-receipts", "test-key-rotation-receipt"],
      "rejectConditions": ["missing-correlation", "sensitive-output", "rollback-failure", "data-loss", "old-test-key-still-accepted"]
    }
  ],
  "criticalRejectionClasses": [
    "identity-or-authorization-failure",
    "tenant-isolation-failure",
    "credential-or-provider-location-disclosure",
    "transaction-capable-rpc-path",
    "deployment-integrity-failure",
    "rollback-or-data-loss-failure"
  ],
  "completionRule": "All stages must bind one promoted exact SHA and configuration digest; any change invalidates later-stage evidence."
}
