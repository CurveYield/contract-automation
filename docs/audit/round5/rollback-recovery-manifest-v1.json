{
  "schemaVersion": "round5-rollback-recovery-manifest-v1",
  "releaseBindingId": "round5-release-source-3da6b10-v1",
  "repository": "CurveYield/contract-automation",
  "state": "static-contract-only",
  "lastKnownGoodBinding": {
    "required": true,
    "requiredFields": [
      "exact-sha",
      "source-tree-digest",
      "configuration-digest",
      "worker-version-identifier",
      "pages-deployment-identifier",
      "r2-policy-digest",
      "domain-routing-checkpoint"
    ]
  },
  "rollbackRequirements": [
    "capture-pre-change-resource-and-configuration-checkpoint",
    "identify-exact-last-known-good-release-and-configuration",
    "use-approved-trusted-rollback-workflow-or-bounded-provider-operation",
    "verify-worker-pages-r2-domain-api-and-web-state-after-rollback",
    "preserve-failed-release-artifacts-and-classified-evidence",
    "prevent-overlap-between-active-deployment-and-rollback"
  ],
  "redeployRequirements": [
    "redeploy-same-exact-sha-and-configuration-digest",
    "prove-idempotent-resource-state",
    "prove-no-duplicate-github-or-r2-authoritative-publication",
    "verify-health-and-source-readback-after-redeploy"
  ],
  "requiredDrills": [
    "rollback-to-last-known-good",
    "idempotent-redeploy",
    "r2-partial-publication-recovery",
    "github-duplicate-publication-reconciliation",
    "non-production-test-key-rotation"
  ],
  "r2PartialPublicationRecovery": {
    "boundedTestPrefixRequired": true,
    "detectOrphanedObjects": true,
    "reconcileAuthoritativeIndex": true,
    "preserveAcceptedDurableReports": true,
    "cleanupEvidenceRequired": true
  },
  "githubDuplicatePublicationRecovery": {
    "boundedTestIssueRequired": true,
    "singleAuthoritativePublicationRequired": true,
    "duplicateDetectionRequired": true,
    "reconciliationCommentRequired": true,
    "unrelatedIssueMutationAllowed": false
  },
  "nonProductionTestKeyRotation": {
    "oldCredentialRejectedAfterRotation": true,
    "newCredentialAcceptedAfterRotation": true,
    "productionHumanWalletMaterialAllowed": false,
    "rotationEvidenceMustBeRedacted": true
  },
  "requiredEvidence": [
    "pre-change-checkpoint",
    "rollback-run-and-target-identifiers",
    "post-rollback-resource-verification",
    "idempotent-redeploy-receipt",
    "r2-recovery-receipt",
    "github-duplicate-reconciliation-receipt",
    "redacted-test-key-rotation-receipt"
  ],
  "rejectConditions": [
    "last-known-good-not-exactly-bound",
    "rollback-does-not-restore-resource-contract",
    "redeploy-creates-unreviewed-drift",
    "authoritative-data-loss",
    "duplicate-authoritative-publication-remains",
    "old-test-credential-remains-valid",
    "sensitive-material-in-recovery-evidence"
  ],
  "destructiveRecoveryAgainstIrreplaceableDataAllowed": false,
  "recoveryDrillsAuthorized": false,
  "authorizer": "account-owner"
}
