        "required-secret-names-confirmed-present-without-values",
        "required-variable-names-confirmed-present-without-values",
        "credential-scope-review-without-material",
        "production-environment-name-confirmed"
      ],
      "permits": ["name-and-scope-readiness-confirmation-only"],
      "doesNotPermit": ["reading-values", "copying-values", "changing-values", "deployment", "live-testing"]
